# Runtime connection: Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Migration connection: Neon direct connection string
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
SESSION_TTL_SECONDS="120"
PORT="10000"
CORS_ORIGIN="*"

# Optional: enable the teacher attendance page at /teacher/attendance.
# ATTENDIFY_TEACHER_DASHBOARD="1"

# Optional independent acoustic HMAC key (32+ characters). Defaults to JWT_SECRET with domain separation.
# ACOUSTIC_TOKEN_SECRET="replace-with-a-separate-long-random-acoustic-secret"
